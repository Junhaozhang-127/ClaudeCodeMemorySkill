{
  "name": "claude-code-memory-skill",
  "version": "0.3.0",
  "description": "Claude Code 会话记忆 Skill — 轻量级本地 Markdown 记忆库",
  "author": "Junhaozhang-127",
  "license": "MIT",
  "keywords": ["memory", "session", "markdown", "context", "skill"],
  "repository": "https://github.com/Junhaozhang-127/ClaudeMeory",

  "skill": {
    "entry": "SKILL.md",
    "description": "自动保存会话为结构化 Markdown 记忆，并在新会话中检索相关上下文。"
  },

  "permissions": {
    "filesystem": {
      "read": ["memory/", "scripts/"],
      "write": ["memory/topics/", "memory/index.json"]
    },
    "execution": {
      "python": ["scripts/summarize_session.py", "scripts/retrieve_memory.py", "scripts/update_index.py"],
      "shell": ["hooks/post_conversation.sh", "hooks/pre_prompt.sh"]
    },
    "network": false
  },

  "configuration": {
    "memory_dir": {
      "type": "string",
      "default": "memory",
      "description": "记忆存储目录（相对于项目根目录）"
    },
    "max_context_items": {
      "type": "integer",
      "default": 5,
      "description": "检索时最多返回的记忆条数"
    },
    "use_jieba": {
      "type": "boolean",
      "default": true,
      "description": "是否使用 jieba 中文分词（需 pip install jieba）"
    }
  },

  "dependencies": {
    "python": ">=3.7",
    "optional": {
      "jieba": ">=0.42"
    }
  },

  "hooks": {
    "post_conversation": {
      "scripts": ["hooks/post_conversation.sh", "hooks/post_conversation.bat", "hooks/post_conversation.ps1"],
      "description": "会话结束后保存对话为 Markdown 记忆"
    },
    "pre_prompt": {
      "scripts": ["hooks/pre_prompt.sh", "hooks/pre_prompt.bat", "hooks/pre_prompt.ps1"],
      "description": "用户输入前检索相关历史记忆"
    }
  },

  "commands": {
    "_comment": "Slash commands are CLI-mapped via SKILL.md declaration. No separate commands/ directory needed.",
    "memory:save": {
      "script": "scripts/summarize_session.py",
      "description": "保存当前对话记忆",
      "usage": "/memory save <主题>",
      "implementation": "CLI-mapped"
    },
    "memory:retrieve": {
      "script": "scripts/retrieve_memory.py",
      "description": "检索相关历史记忆",
      "usage": "/memory retrieve <查询>",
      "implementation": "CLI-mapped"
    },
    "memory:rebuild": {
      "script": "scripts/update_index.py",
      "description": "重建记忆索引",
      "usage": "/memory rebuild",
      "implementation": "CLI-mapped"
    }
  },

  "installation": {
    "steps": [
      "git clone https://github.com/Junhaozhang-127/ClaudeMeory.git",
      "cd ClaudeMeory",
      "pip install -r requirements.txt",
      "python scripts/update_index.py",
      "将 docs/settings.template.json 中的 Hook 配置合并到 Claude Code settings.json"
    ],
    "verify": "python tests/test_memory_skill.py"
  }
}
